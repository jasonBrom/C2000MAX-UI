<div class="theme-picker"><button type="button" class="theme-toggle icon-button" data-theme-toggle aria-label="外观模式" title="外观模式" aria-expanded="false" aria-controls="theme-options"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#monitor"/></svg></button>
      <div class="theme-control" id="theme-options" role="group" aria-label="外观模式">
        <button type="button" data-theme-choice="light" aria-pressed="false" aria-label="浅色模式" title="浅色模式"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#sun"/></svg><span class="theme-choice-label">浅色</span></button>
        <button type="button" data-theme-choice="dark" aria-pressed="false" aria-label="深色模式" title="深色模式"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#moon"/></svg><span class="theme-choice-label">深色</span></button>
        <button type="button" data-theme-choice="system" aria-pressed="true" aria-label="跟随系统" title="跟随系统"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#monitor"/></svg><span class="theme-choice-label">跟随系统</span></button>
      </div>
      </div>
