{%
 import { readfile } from 'fs';
 let wallpaper = {};
 try { wallpaper = json(readfile('/www/luci-static/c2000max-ui/wallpaper/default.json')); } catch (e) {}
 http.prepare_content('text/html; charset=UTF-8');
-%}
<!doctype html>
<html lang="{{ dispatcher.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#111111">
<title>C2000MAX · 登录</title>
<script src="{{ media }}/liquid-router.js?v=liquidGL-11"></script>
<script src="{{ media }}/theme.js?v=liquidGL-11"></script>
<link rel="stylesheet" href="{{ media }}/tokens.css?v=1.0.22-r1">
<link rel="stylesheet" href="{{ media }}/components.css?v=1.0.22-r1">
<link rel="stylesheet" href="{{ media }}/login.css?v=1.0.22-r1">
<link rel="stylesheet" href="{{ media }}/liquid-router.css?v=liquidGL-11">
<link rel="stylesheet" href="{{ media }}/liquid.css?v=liquidGL-11">
<link rel="stylesheet" href="{{ media }}/liquid-motion.css?v=liquidGL-11">
<script src="{{ media }}/login.js?v=liquidGL-11" defer></script>
<script src="{{ media }}/liquid-motion.js?v=liquidGL-11" defer></script>
<script src="{{ media }}/liquid.js?v=liquidGL-11" defer></script>
</head>
<body class="login-page">
{% include('themes/c2000max-ui/icons') %}
<div class="liquid-scene" id="liquid-scene" aria-hidden="true">
<img class="login-wallpaper" src="{{ media }}/wallpaper/default.jpg" data-fallback="{{ media }}/wallpaper/default.jpg" data-date="{{ entityencode(wallpaper.date ?? '', true) }}" alt="" aria-hidden="true">
<div class="login-shade" aria-hidden="true"></div>
</div>
<header class="login-top"><a class="login-brand" href="{{ dispatcher.build_url() }}"><strong>C2000MAX</strong><span>NRadio C2000-788</span></a>
{% include('themes/c2000max-ui/appearance') %}
</header>
<main class="login-center">
<section class="login-card" aria-labelledby="login-title" data-glass="clear">
<div class="login-mark" aria-hidden="true"><svg class="icon" viewBox="0 0 24 24"><use href="#wifi"/></svg></div>
<p class="login-eyebrow">C2000MAX · ImmortalWrt 25.12</p>
<h1 id="login-title">欢迎回来</h1>
<p class="login-description">登录以管理你的网络与设备</p>
{% if (fuser): %}<p class="login-error" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</p>{% endif %}
{% if (auth_message): %}<p class="login-error">{{ entityencode(auth_message) }}</p>{% endif %}
<form method="post" action="{{ entityencode(http.getenv('REQUEST_URI'), true) }}" autocomplete="on">
<label class="login-field" for="luci_username">用户名<input id="luci_username" name="luci_username" type="text" value="{{ entityencode(duser ?? 'root', true) }}" autocomplete="username" autocapitalize="none" spellcheck="false" required></label>
<label class="login-field" for="luci_password">密码<span class="login-password"><input id="luci_password" name="luci_password" type="password" autocomplete="current-password" autofocus><button type="button" id="password-toggle" aria-label="显示密码" aria-pressed="false"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#eye"/></svg></button></span></label>
<button class="ui-button login-submit" type="submit">登录<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#arrow"/></svg></button>
</form>
<p class="login-footer"><a href="https://github.com/jasonBrom/C2000MAX-UI" target="_blank" rel="noopener noreferrer">C2000MAX-UI 2026 By inst.</a></p>
</section>
</main>
<footer class="wallpaper-credit"><a href="https://www.bing.com" target="_blank" rel="noopener noreferrer" title="{{ entityencode(wallpaper.copyright ?? '', true) }}"><span class="wallpaper-credit-text">Bing 每日壁纸 · {{ entityencode(wallpaper.copyright ?? wallpaper.date ?? '') }}</span></a></footer>
{%
 let https_ports = uci.get('uhttpd', 'main', 'listen_https') ?? [];
 https_ports = uniq(filter(map(type(https_ports) == 'string' ? split(https_ports, /\s+/) : https_ports, e => +match(e, /\d+$/)?.[0]), p => p > 0 && p <= 65535));
%}
<script>
// Preserve LuCI's HTTPS auto-detection when a TLS listener is available.
if (location.protocol !== 'https:') {
 {{ https_ports }}.forEach(function(port) {
  var base = 'https://' + location.hostname + ':' + port, probe = new Image();
  probe.onload = function() { location.replace(base + location.pathname + location.search + location.hash); };
  probe.src = base + '{{ resource }}/icons/loading.svg?' + Date.now();
  setTimeout(function() { probe.src = ''; }, 5000);
 });
}
</script>
</body>
</html>
